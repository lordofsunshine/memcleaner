<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>MemCleanerLegacy</RootNamespace>
    <AssemblyName>MemCleaner</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>lordofsunshine</Authors>
    <Company>lordofsunshine</Company>
    <Product>memcleaner</Product>
    <Copyright>MIT License, lordofsunshine</Copyright>
    <Description>Memory cleaner for Windows XP, Vista, 7 and 8.1</Description>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.ini" />
    <None Include="Assets\app.ico" />
  </ItemGroup>

</Project>
