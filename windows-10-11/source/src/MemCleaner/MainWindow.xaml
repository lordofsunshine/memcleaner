<Window x:Class="MemCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MemCleaner.Views"
        xmlns:loc="clr-namespace:MemCleaner.Localization"
        Title="memcleaner"
        Icon="Assets/app.ico"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/app.png"
                           Width="38"
                           Height="38"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="memcleaner" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="memcleaner"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr appTagline}" Style="{StaticResource MicroText}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <RadioButton Content="{loc:Tr navOverview}"
                                 Tag="&#xE80F;"
                                 GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="overview"
                                 AutomationProperties.Name="{loc:Tr navOverview}"
                                 IsChecked="{Binding IsOverviewPage, Mode=OneWay}" />
                    <RadioButton Content="{loc:Tr navSettings}"
                                 Tag="&#xE713;"
                                 GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="settings"
                                 AutomationProperties.Name="{loc:Tr navSettings}"
                                 IsChecked="{Binding IsSettingsPage, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding VersionText}"
                           Style="{StaticResource MicroText}"
                           Margin="2,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <views:OverviewView Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVis}}" />
            <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
