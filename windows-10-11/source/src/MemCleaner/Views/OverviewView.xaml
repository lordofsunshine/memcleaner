<UserControl x:Class="MemCleaner.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MemCleaner.Controls"
             xmlns:loc="clr-namespace:MemCleaner.Localization"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,24">

            <TextBlock Text="{loc:Tr overviewTitle}" Style="{StaticResource HeadingText}" />

            <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="182" Height="182" VerticalAlignment="Center">
                        <controls:RingGauge Value="{Binding UsedPercent}"
                                            Thickness="12"
                                            AccentBrush="{StaticResource AccentBrush}"
                                            AccentEndBrush="{StaticResource AccentDeepBrush}"
                                            TrackBrush="#1D2621" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsedPercentText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="38"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,-4,0,0" />
                            <TextBlock Text="{loc:Tr metricUsed}"
                                       Style="{StaticResource MicroText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TotalLabel}"
                                       Style="{StaticResource MicroText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="{loc:Tr metricUsed}" Style="{StaticResource MicroText}" />
                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,16">
                                <TextBlock Text="{loc:Tr metricFree}" Style="{StaticResource MicroText}" />
                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Tr metricFileCache}" Style="{StaticResource MicroText}" />
                                <TextBlock Text="{Binding CachedText}" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="{loc:Tr metricAllocated}" Style="{StaticResource MicroText}" />
                                <TextBlock Text="{Binding CommitText}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:Tr overviewChartCaption}" Style="{StaticResource MicroText}" />
                            <controls:Sparkline Height="44"
                                                Margin="0,8,0,0"
                                                Samples="{Binding Samples}"
                                                AccentBrush="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr overviewCleanTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AreasLine}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        <TextBlock Text="{loc:Tr overviewCleanNote}"
                                   Style="{StaticResource MicroText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding CleanCommand}"
                                Margin="0,14,0,0"
                                AutomationProperties.Name="{loc:Tr cleanButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15"
                                           Foreground="#07170E"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CleanButtonText}"
                                           Margin="10,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#07170E"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding LastResult}"
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="{Binding LastResultBrush}"
                                   Margin="0,10,0,0"
                                   MinHeight="34"
                                   Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr overviewAutoTitle}"
                                       Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding IsAutoEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="10,0,0,0"
                                      AutomationProperties.Name="{loc:Tr overviewAutoTitle}" />
                        </Grid>
                        <TextBlock Text="{Binding AutoSummary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="{Binding AutoDetails}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0" />
                        <Button Style="{StaticResource GhostButton}"
                                Content="{loc:Tr buttonConfigure}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="settings"
                                AutomationProperties.Name="{loc:Tr navSettings}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="24,18" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Tr historyTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Tr historyCaption}"
                                   Style="{StaticResource MicroText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding History}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource MicroText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Trigger}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Freed}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr historyEmpty}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
